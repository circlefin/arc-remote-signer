USE_LOCALSTACK=${USE_LOCALSTACK:-true}
APP_PROVIDER_SECRETS_LOCALSTACK_ENABLED=${APP_PROVIDER_SECRETS_LOCALSTACK_ENABLED:-true}
APP_PROVIDER_AWSKMS_LOCALSTACK_ENABLED=${APP_PROVIDER_AWSKMS_LOCALSTACK_ENABLED:-true}
# Single switch for Nitro enclave mode in local dev/CI. common.sh derives the
# host app flag from it and docker-compose feeds it into both the vsockproxy and
# enclave services, so nothing can drift. The ${:-} form lets an ambient
# ENABLE_ENCLAVE override the default without editing this file.
#
# Keep false: plain Docker has no Nitro device / NSM, so docker-compose only
# exercises the non-Nitro (TCP + LocalStack) path — setting this true here would
# not produce a working Nitro setup. Real Nitro mode is exercised by the EIF
# smoke test on a Nitro host (scripts/smoke-eif.sh), not via compose.
ENABLE_ENCLAVE=${ENABLE_ENCLAVE:-false}
